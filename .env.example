


# 应用配置
APP_NAME=OmniSupport AI
DEBUG=false

# 大语言模型配置
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Rerank 重排序服务配置
RERANK_API_URL=
# PostgreSQL
DATABASE_URL=postgresql+psycopg://omnisupport_app:your-password@127.0.0.1:5432/omnisupport_ai
# JWT 身份认证配置
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Qdrant 向量数据库配置
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=