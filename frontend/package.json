{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write src index.html vite.config.ts package.json README.md docs/*.md",
    "format:check": "prettier --check src index.html vite.config.ts package.json README.md docs/*.md"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.1.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
